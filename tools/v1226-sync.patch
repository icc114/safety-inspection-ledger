+    /**
+     * Mobile DNS/VPN hand-offs can briefly fail even after a successful probe. Retry only
+     * transient transport failures and temporary server statuses; authentication and other
+     * permanent 4xx errors still fail immediately.
+     */
+    private Response executeWithRetry(Request request, String operation) throws Exception {
+        java.io.IOException last = null;
+        for (int attempt = 1; attempt <= NETWORK_ATTEMPTS; attempt++) {
+            try {
+                Response response = http.newCall(request).execute();
+                if (attempt < NETWORK_ATTEMPTS && retryableHttp(response.code())) {
+                    response.close();
+                    sleepBackoff(attempt);
+                    continue;
+                }
+                return response;
+            } catch (java.io.IOException error) {
+                last = error;
+                if (attempt >= NETWORK_ATTEMPTS || !retryableNetwork(error)) throw error;
+                sleepBackoff(attempt);
+            }
+        }
+        throw last == null ? new java.io.IOException(operation + "失败") : last;
+    }
+
+    private boolean retryableNetwork(java.io.IOException error) {
+        if (error instanceof javax.net.ssl.SSLException) return false;
+        return error instanceof java.net.UnknownHostException
+                || error instanceof java.net.SocketTimeoutException
+                || error instanceof java.net.ConnectException
+                || error instanceof java.net.SocketException
+                || error.getMessage() != null && (error.getMessage().contains("unexpected end of stream")
+                || error.getMessage().contains("Connection reset")
+                || error.getMessage().contains("Broken pipe"));
+    }
+
+    private boolean retryableHttp(int code) {
+        return code == 408 || code == 425 || code == 429 || code == 500
+                || code == 502 || code == 503 || code == 504;
+    }
+
+    private void sleepBackoff(int attempt) throws InterruptedException {
+        long delay = new long[]{0L, 1200L, 2500L, 5000L}[Math.min(attempt, 3)];
+        Thread.sleep(delay);
+    }
 
